<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SupportedOSPlatform>windows10.0.19041.0</SupportedOSPlatform>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>AimMac.Receiver</RootNamespace>
    <AssemblyName>AimMacReceiver</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Description>AimMac Windows BLE receiver. Cursor control is disarmed by default.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AimMac.Core\AimMac.Core.csproj" />
  </ItemGroup>
</Project>
